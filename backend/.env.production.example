# PRODUCTION deployment — a PARTIAL overlay. backend/.env on the production
# host is hand-maintained; merge these keys into it, do not copy this file
# over it (it has no JWT_SECRET, DATABASE_URL, etc. — copying wholesale
# produces a broken env).
# Keys come from the Midtrans dashboard's PRODUCTION tab (dashboard.midtrans.com).
# A production key never carries the SB- prefix — but the reverse is not a rule:
# plenty of SANDBOX keys have no prefix either, so absence proves nothing.
#
# ⚠️ Every transaction made with these keys moves real money.
APP_ENV=production

# Paste the production Server Key here (starts with Mid-server-).
MIDTRANS_SERVER_KEY=

# Optional gateway override; leave blank to follow APP_ENV. Setting this to
# sandbox on a production host is the only way to point real traffic at fake
# money, and vice versa — leave it blank unless you are deliberately doing that.
MIDTRANS_ENV=

# Required — the backend fatals on boot without it outside DEV_MODE. Generate
# a fresh random secret for THIS environment; never reuse JWT_SECRET's value
# or the sandbox environment's TICKETMAN_JWT_SECRET.
TICKETMAN_JWT_SECRET=

# This deployment's real production frontend origin, scheme included, no trailing
# slash. Required — main.go refuses to boot without it on this host. E-ticket
# emails link here, and it is also what keeps the Google OAuth redirect and
# password-reset links safe: without it both fall back to validating the
# request's own Origin/Host against ALLOWED_FRONTEND_ORIGINS, or fail closed
# if that is unset too.
FRONTEND_URL=
