# Sandbox deployment — a PARTIAL overlay. backend/.env on the sandbox host
# is hand-maintained; merge these keys into it, do not copy this file over
# it (it has no JWT_SECRET, DATABASE_URL, etc. — copying wholesale produces
# a broken env).
# Keys come from the Midtrans dashboard's SANDBOX tab (dashboard.sandbox.midtrans.com).
# Many sandbox keys are prefixed SB-, but NOT all are — a missing prefix does not
# mean a key is production. The tab you copied from is what decides.
APP_ENV=sandbox

# Paste the sandbox Server Key here (starts with SB-Mid-server-).
MIDTRANS_SERVER_KEY=

# Optional gateway override; leave blank to follow APP_ENV.
MIDTRANS_ENV=

# Required — the backend fatals on boot without it outside DEV_MODE. Generate
# a fresh random secret for THIS environment; never reuse JWT_SECRET's value
# or the production environment's TICKETMAN_JWT_SECRET.
TICKETMAN_JWT_SECRET=

# This deployment's real sandbox frontend origin, scheme included, no trailing
# slash. Required — main.go refuses to boot without it on this host. E-ticket
# emails link here, and it is also what keeps the Google OAuth redirect and
# password-reset links safe: without it both fall back to validating the
# request's own Origin/Host against ALLOWED_FRONTEND_ORIGINS, or fail closed
# if that is unset too.
FRONTEND_URL=
