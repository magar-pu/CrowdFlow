# Which deployment this is. Drives Secure cookies, the JWT_SECRET requirement,
# and which Midtrans gateway is used.
#   production — the real site. Real money.
#   sandbox    — the public sandbox host. Strict like production, fake money.
#   local      — a developer laptop. Relaxed cookies, insecure JWT fallback.
APP_ENV=local

# Per-environment - each deployment (prod, sandbox, local) needs its own
# database, secrets, and redirect URI. Never share these values across
# environments.
DB_DSN=postgres://postgres:postgres@host.docker.internal:5432/crowdflow?sslmode=disable
JWT_SECRET=
GOOGLE_REDIRECT_URI=

GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET_NAME=
S3_PRIVATE_BUCKET_NAME=
S3_REGION=
S3_PUBLIC_BASE_URL=http://localhost:9000/crowdflow-public

# Midtrans — the keys live in the per-environment example files, so a sandbox
# host never has a production key on disk. Copy from whichever applies:
#   .env.sandbox.example     (from dashboard.sandbox.midtrans.com)
#   .env.production.example  (from dashboard.midtrans.com)
#
# Do not judge a key by its prefix: SB- means sandbox, but its ABSENCE proves
# nothing — sandbox keys without the prefix exist. To settle which gateway a key
# belongs to, ask Midtrans:
#   curl -u "$MIDTRANS_SERVER_KEY:" #     https://api.sandbox.midtrans.com/v2/any-unknown-order-id/status
# 404 "Transaction doesn't exist" = valid for that gateway. 401 = not.
MIDTRANS_SERVER_KEY=

# Resend Mail Service
RESEND_API_KEY=
RESEND_FROM_EMAIL=CrowdFlow <onboarding@resend.dev>

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

