{
  "name": "crowdflow-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:admin": "npm run dev --prefix admin",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:admin\"",
    "build": "next build",
    "build:admin": "npm run build --prefix admin",
    "build:all": "npm run build && npm run build:admin",
    "start": "next start",
    "start:admin": "npm run start --prefix admin",
    "start:all": "concurrently \"npm run start\" \"npm run start:admin\"",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
