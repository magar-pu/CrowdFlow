# Read by `npm run dev` ONLY. docker-compose.yml's frontend service does not
# reference this file at all (no env_file) — a containerised deploy (local
# compose stack, sandbox, prod) gets these three values purely from the ROOT
# .env, passed through as `environment:` and picked up at container START by
# frontend/docker-entrypoint.sh (see src/lib/runtimeEnv.ts for how the client
# bundle reads them). Setting a real value ONLY here and expecting a
# container to see it is a dead end: docker-compose.yml deliberately does not
# wire this file in, specifically so it can never silently shadow (or be
# shadowed by) the root .env's values — keep both files in sync by hand if
# you need the same key in both places for local dev.
#
# NEXT_PUBLIC_* ends up visible to anyone who opens devtools, however it's
# delivered. Only ever put publishable half-of-a-pair keys here; the secret
# halves live in backend/.env.

# Midtrans Snap client key, from the same dashboard tab as the backend's
# MIDTRANS_SERVER_KEY (sandbox vs production). A client key from one gateway
# and a server key from the other fails at checkout, not at boot.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Cloudflare Turnstile site key — the public half of TURNSTILE_SECRET_KEY in
# backend/.env. Both halves must come from the same Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
