# Read by `npm run dev` only. Under docker compose this file is EXCLUDED by
# frontend/.dockerignore and never reaches the image — the compose build reads
# the same two values from the ROOT .env and passes them as build args instead.
# Setting them here and expecting a container to see them is the trap that
# shipped `undefined` as the client key to every containerised deploy.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time and is visible
# to anyone who opens devtools. Only ever put publishable half-of-a-pair keys
# here; the secret halves live in backend/.env.

# Midtrans Snap client key, from the same dashboard tab as the backend's
# MIDTRANS_SERVER_KEY (sandbox vs production). A client key from one gateway
# and a server key from the other fails at checkout, not at boot.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Cloudflare Turnstile site key — the public half of TURNSTILE_SECRET_KEY in
# backend/.env. Both halves must come from the same Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
