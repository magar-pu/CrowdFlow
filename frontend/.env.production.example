# PRODUCTION deployment — copy to frontend/.env on the production host.
#
# These are build-time values: Next inlines NEXT_PUBLIC_* into the client
# bundle during `npm run build`, so editing frontend/.env after the image is
# built changes nothing — see docker-compose.yml's frontend build.args and
# frontend/Dockerfile. A rebuild is required for a new value to take effect.
#
# ⚠️ Every transaction made with these keys moves real money.

# Keys come from the Midtrans dashboard's PRODUCTION tab (dashboard.midtrans.com).
# A production key never carries the SB- prefix — but the reverse is not a rule:
# plenty of SANDBOX keys have no prefix either, so absence proves nothing.
# Paste the production Client Key here (starts with Mid-client-).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Paste the production Turnstile site key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
