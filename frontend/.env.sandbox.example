# Sandbox deployment — copy to frontend/.env on the sandbox host.
#
# These are build-time values: Next inlines NEXT_PUBLIC_* into the client
# bundle during `npm run build`, so editing frontend/.env after the image is
# built changes nothing — see docker-compose.yml's frontend build.args and
# frontend/Dockerfile. A rebuild is required for a new value to take effect.

# Keys come from the Midtrans dashboard's SANDBOX tab (dashboard.sandbox.midtrans.com).
# Many sandbox keys are prefixed SB-, but NOT all are — a missing prefix does not
# mean a key is production. The tab you copied from is what decides.
# Paste the sandbox Client Key here (starts with SB-Mid-client-).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Paste the sandbox Turnstile site key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
