{
  "module": "EO Scanner",
  "version": "1.0",
  "mode": "Zero Login",
  "platform": [
    "PWA",
    "Android"
  ],
  "workflow": [
    "Open Scanner",
    "Open Camera",
    "Scan QR",
    "Backend Verify",
    "Success or Failed",
    "Return To Scanner"
  ],
  "success": {
    "screen": "green",
    "duration": 2000,
    "sound": true,
    "vibration": true,
    "autoReturn": true
  },
  "failed": {
    "screen": "red",
    "duration": 2000,
    "autoReturn": true
  },
  "validation": [
    "signature",
    "event",
    "ticket",
    "status",
    "duplicate"
  ],
  "status": [
    "VALID",
    "INVALID",
    "ALREADY_USED",
    "WRONG_EVENT",
    "REFUNDED",
    "CANCELLED",
    "EXPIRED",
    "SERVER_ERROR"
  ],
  "database": {
    "tables": [
      "scanner_devices",
      "scanner_logs",
      "ticket_checkins",
      "event_gates"
    ]
  },
  "api": {
    "checkin": "POST /api/scanner/checkin",
    "status": "GET /api/scanner/status",
    "dashboard": "GET /api/scanner/dashboard",
    "live": "GET /api/scanner/live"
  },
  "performance": {
    "targetResponse": "<500ms",
    "maxConcurrentScanners": 100,
    "maxCheckinPerHour": 50000,
    "uptime": "99.9%"
  },
  "future": [
    "offline mode",
    "wallet integration",
    "nfc",
    "ai fraud detection",
    "face verification"
  ]
}