# Compose-level port overrides only (used for host port bindings in
# docker-compose.yml). Not read by the application itself - that's
# backend/.env. Only needed when running more than one environment
# (prod + sandbox) on the same host, so each stack's containers can bind to
# distinct localhost ports without colliding.
#
# Prod checkout: leave this file absent and the defaults below apply.
# Sandbox checkout: copy this to .env and pick different port numbers.
NGINX_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Which images this host pulls and which tag. See .github/workflows for how
# these get built and pushed:
#   IMAGE_TAG=sha-<short>  for the sandbox host (every push to dev)
#   IMAGE_TAG=v1.2.3       for the production host (every `git tag vX.Y.Z`)
# Rollback on either host is: change this line, `docker compose up -d`. No
# rebuild, no git pull — the image already exists in the registry.
GHCR_OWNER=<github-org-or-user>
IMAGE_TAG=latest

# Passed into the frontend container at container START (see
# frontend/docker-entrypoint.sh and src/lib/runtimeEnv.ts) — NOT at image
# build time any more. One frontend image now serves every environment;
# these three lines are the only thing that differs between the prod and
# sandbox stacks for the frontend service.
APP_ENV=local
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
