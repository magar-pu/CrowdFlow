# Compose-level port overrides only (used for host port bindings in
# docker-compose.yml). Not read by the application itself - that's
# backend/.env. Only needed when running more than one environment
# (prod + sandbox) on the same host, so each stack's containers can bind to
# distinct localhost ports without colliding.
#
# Prod checkout: leave this file absent and the defaults below apply.
# Sandbox checkout: copy this to .env and pick different port numbers.
NGINX_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=3000
